<div class="px-4 sm:px-6 lg:px-8 py-8">
  <div class="sm:flex sm:items-center sm:justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Users</h1>
    <%= link_to "New User", new_admin_user_path, class: "mt-4 sm:mt-0 inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" %>
  </div>

  <!-- Search -->
  <div class="mt-6">
    <%= form_with url: admin_users_path, method: :get, local: true, class: "flex gap-4" do |f| %>
      <div class="flex-1">
        <%= f.search_field :search, value: params[:search], placeholder: "Search by name or email...", class: "block w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
      </div>
      <%= f.submit "Search", class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 cursor-pointer" %>
    <% end %>
  </div>

  <!-- Desktop Table -->
  <div class="mt-6 hidden md:block">
    <div class="overflow-hidden shadow ring-1 ring-black/5 rounded-lg">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Name</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Email</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Role</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Dealer</th>
            <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
            <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @users.each do |user| %>
            <tr>
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                <%= user.first_name %> <%= user.last_name %>
              </td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= user.email %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= user.role.humanize %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= user.dealer&.name %></td>
              <td class="whitespace-nowrap px-3 py-4 text-sm">
                <% if user.active? %>
                  <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">Inactive</span>
                <% end %>
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                <div class="flex items-center justify-end gap-3">
                  <%= link_to "Edit", edit_admin_user_path(user), class: "text-indigo-600 hover:text-indigo-900" %>
                  <%= link_to user.active? ? "Deactivate" : "Activate",
                        toggle_active_admin_user_path(user),
                        data: { turbo_method: :patch, turbo_confirm: "Are you sure?" },
                        class: user.active? ? "text-red-600 hover:text-red-900" : "text-green-600 hover:text-green-900" %>
                  <%= link_to "Resend Confirmation", resend_confirmation_admin_user_path(user),
                        data: { turbo_method: :post },
                        class: "text-gray-600 hover:text-gray-900" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Mobile Cards -->
  <div class="mt-6 space-y-4 md:hidden">
    <% @users.each do |user| %>
      <div class="rounded-lg bg-white p-4 shadow">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-medium text-gray-900"><%= user.first_name %> <%= user.last_name %></h3>
          <% if user.active? %>
            <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Active</span>
          <% else %>
            <span class="inline-flex items-center rounded-full bg-red-50 px-2 py-1 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">Inactive</span>
          <% end %>
        </div>
        <p class="mt-1 text-sm text-gray-500"><%= user.email %></p>
        <div class="mt-2 flex items-center gap-2 text-xs text-gray-500">
          <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-600"><%= user.role.humanize %></span>
          <% if user.dealer.present? %>
            <span>&middot; <%= user.dealer.name %></span>
          <% end %>
        </div>
        <div class="mt-3 flex items-center gap-3 border-t border-gray-100 pt-3">
          <%= link_to "Edit", edit_admin_user_path(user), class: "text-sm text-indigo-600 hover:text-indigo-900" %>
          <%= link_to user.active? ? "Deactivate" : "Activate",
                toggle_active_admin_user_path(user),
                data: { turbo_method: :patch, turbo_confirm: "Are you sure?" },
                class: user.active? ? "text-sm text-red-600 hover:text-red-900" : "text-sm text-green-600 hover:text-green-900" %>
          <%= link_to "Resend", resend_confirmation_admin_user_path(user),
                data: { turbo_method: :post },
                class: "text-sm text-gray-600 hover:text-gray-900" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <div class="mt-6 flex justify-center">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
