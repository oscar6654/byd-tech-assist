<div class="flex items-center gap-3 p-2 rounded-lg hover:bg-gray-50 group" id="attachment_<%= attachment.id %>">
  <% if attachment.image? && attachment.file.attached? %>
    <%= image_tag attachment.file, class: "w-10 h-10 sm:w-12 sm:h-12 rounded-lg object-cover border border-gray-200 shrink-0" %>
  <% elsif attachment.video? %>
    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-purple-100 flex items-center justify-center shrink-0">
      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
  <% else %>
    <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg bg-gray-100 flex items-center justify-center shrink-0">
      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    </div>
  <% end %>

  <div class="flex-1 min-w-0">
    <% if attachment.file.attached? %>
      <% if attachment.video? && attachment.browser_playable? %>
        <div data-controller="video-player">
          <video controls preload="metadata" class="w-full max-w-md rounded-lg mt-1" data-video-player-target="video">
            <source src="<%= rails_blob_url(attachment.file) %>" type="<%= attachment.file.content_type %>">
          </video>
          <div class="hidden" data-video-player-target="fallback">
            <%= link_to attachment.file_name, rails_blob_path(attachment.file, disposition: :attachment), class: "text-sm text-blue-600 hover:text-blue-800 font-medium" %>
            <span class="text-xs text-gray-400">(Download)</span>
          </div>
        </div>
      <% else %>
        <%= link_to attachment.file_name, rails_blob_path(attachment.file, disposition: :inline), target: "_blank", class: "text-sm text-blue-600 hover:text-blue-800 font-medium truncate block" %>
      <% end %>
    <% end %>
    <span class="text-xs text-gray-400"><%= attachment.file.content_type %></span>
  </div>

  <% if attachment.tarf.can_manage?(current_user) %>
    <%= button_to tarf_tarf_attachment_path(attachment.tarf, attachment), method: :delete, data: { turbo_confirm: "Delete this file?" }, class: "shrink-0 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity text-red-500 hover:text-red-700 p-1" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
    <% end %>
  <% end %>
</div>
