<%= form_with(model: @tarf, class: "bg-white rounded-lg shadow p-8 space-y-6") do |f| %>
  <% if @tarf.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4">
      <h3 class="text-sm font-medium text-red-800 mb-2"><%= pluralize(@tarf.errors.count, "error") %> prevented this TARF from being saved:</h3>
      <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
        <% @tarf.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :title, required: true, placeholder: "Enter TARF title", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :description, rows: 5, required: true, placeholder: "Describe the issue in detail", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div>
    <%= f.label :problem_summary, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :problem_summary, rows: 3, placeholder: "Brief summary of the problem", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <%= f.label :byd_model_id, "BYD Model", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :byd_model_id, options_for_select(BydModel.active.sorted.map { |m| [m.name, m.id] }, @tarf.byd_model_id), { include_blank: "Select Model" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :category, options_for_select(Tarf.categories.keys.map { |c| [c == "tsb" ? "TSB" : c.humanize, c] }, @tarf.category), {}, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>
  </div>

  <% if current_user.admin? %>
    <div>
      <%= f.label :dealer_id, "Dealer", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :dealer_id, options_for_select(Dealer.active.sorted.map { |d| [d.display_name, d.id] }, @tarf.dealer_id), { include_blank: "Select Dealer" }, class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>
  <% end %>

  <div>
    <%= f.label :keywords, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :keywords, placeholder: "e.g. battery, AC, steering", class: "w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div>
    <%= f.label :tarf_pdf, "TARF PDF Document", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <% if @tarf.tarf_pdf.attached? %>
      <div class="flex items-center gap-2 mb-2 text-sm text-gray-600">
        <svg class="w-4 h-4 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
        <%= link_to @tarf.tarf_pdf.filename, rails_blob_path(@tarf.tarf_pdf, disposition: "inline"), target: "_blank", class: "text-blue-600 hover:underline" %>
        <span class="text-gray-400">(<%= number_to_human_size(@tarf.tarf_pdf.byte_size) %>)</span>
      </div>
    <% end %>
    <%= f.file_field :tarf_pdf, accept: "application/pdf", class: "w-full text-sm text-gray-500 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-red-50 file:text-red-700 hover:file:bg-red-100" %>
    <p class="mt-1 text-xs text-gray-400">Upload the TARF PDF document (optional). Only PDF files accepted.</p>
  </div>

  <div class="flex items-center gap-3 pt-3">
    <%= f.submit class: "px-5 py-2.5 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors cursor-pointer" %>
    <%= link_to "Cancel", @tarf.persisted? ? tarf_path(@tarf) : tarfs_path, class: "px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
  </div>
<% end %>
