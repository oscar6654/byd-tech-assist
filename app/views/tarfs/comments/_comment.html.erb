<div class="flex gap-3" id="comment_<%= comment.id %>">
  <div class="flex-shrink-0 w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center">
    <span class="text-xs font-semibold text-white"><%= comment.user.first_name[0] %><%= comment.user.last_name[0] %></span>
  </div>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-sm font-medium text-gray-900"><%= comment.user.full_name %></span>
      <span class="text-xs text-gray-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
      <% if defined?(current_user) && current_user && (comment.user == current_user || current_user.admin?) %>
        <%= button_to "Delete", tarf_comment_path(comment.tarf, comment), method: :delete, data: { turbo_confirm: "Delete this comment?" }, class: "text-xs text-red-500 hover:text-red-700 ml-auto" %>
      <% end %>
    </div>
    <div class="text-sm text-gray-700"><%= simple_format(comment.body) %></div>
  </div>
</div>
