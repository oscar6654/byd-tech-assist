<div class="flex h-full flex-col">
  <div class="flex h-16 shrink-0 items-center px-4">
    <h1 class="text-xl font-bold text-white">BYD Tech Assist</h1>
  </div>
  <nav class="flex flex-1 flex-col px-2 pb-4 space-y-1">
    <%= link_to tarfs_path, class: "group flex items-center gap-x-3 rounded-md px-3 py-2 text-sm font-medium #{active_link_class(tarfs_path)}" do %>
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
      TARFs
    <% end %>

    <%= link_to new_tarf_path, class: "group flex items-center gap-x-3 rounded-md px-3 py-2 text-sm font-medium #{active_link_class(new_tarf_path)}" do %>
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
