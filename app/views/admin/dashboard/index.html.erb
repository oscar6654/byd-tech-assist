<div class="px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>

  <!-- Stat Cards -->
  <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5">
    <%= link_to admin_users_path, class: "overflow-hidden rounded-lg bg-white shadow hover:shadow-md transition" do %>
      <div class="px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Total Users</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_users %></dd>
      </div>
    <% end %>

    <%= link_to admin_dealers_path, class: "overflow-hidden rounded-lg bg-white shadow hover:shadow-md transition" do %>
      <div class="px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Total Dealers</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_dealers %></dd>
      </div>
    <% end %>

    <div class="overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Total TARFs</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-gray-900"><%= @total_tarfs %></dd>
      </div>
    </div>

    <div class="overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Open TARFs</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-indigo-600"><%= @open_tarfs %></dd>
      </div>
    </div>

    <div class="overflow-hidden rounded-lg bg-white shadow">
      <div class="px-4 py-5 sm:p-6">
        <dt class="truncate text-sm font-medium text-gray-500">Resolved TARFs</dt>
        <dd class="mt-1 text-3xl font-semibold tracking-tight text-green-600"><%= @resolved_tarfs %></dd>
      </div>
    </div>
  </div>

  <!-- Recent TARFs -->
  <div class="mt-8">
    <h2 class="text-lg font-semibold text-gray-900">Recent TARFs</h2>

    <!-- Desktop Table -->
    <div class="mt-4 hidden md:block">
      <div class="overflow-hidden shadow ring-1 ring-black/5 rounded-lg">
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">TARF #</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Title</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Dealer</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Created</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @recent_tarfs.each do |tarf| %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-indigo-600 sm:pl-6">
                  <%= tarf.tarf_number %>
                </td>
                <td class="px-3 py-4 text-sm text-gray-900"><%= tarf.title %></td>
                <td class="px-3 py-4 text-sm"><%= status_badge(tarf.status) %></td>
                <td class="px-3 py-4 text-sm text-gray-500"><%= tarf.dealer&.name %></td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500"><%= tarf.created_at.strftime("%b %d, %Y") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Mobile Cards -->
    <div class="mt-4 space-y-4 md:hidden">
      <% @recent_tarfs.each do |tarf| %>
        <div class="rounded-lg bg-white p-4 shadow">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-indigo-600"><%= tarf.tarf_number %></span>
            <%= status_badge(tarf.status) %>
          </div>
          <p class="mt-2 text-sm font-medium text-gray-900"><%= tarf.title %></p>
          <div class="mt-2 flex items-center justify-between text-sm text-gray-500">
            <span><%= tarf.dealer&.name %></span>
            <span><%= tarf.created_at.strftime("%b %d, %Y") %></span>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
