<%= form_with url: tarf_tarf_folders_path(tarf), scope: :tarf_folder, id: "new_folder_form", class: "flex flex-col sm:flex-row gap-2" do |f| %>
  <%= f.text_field :name, placeholder: "New folder name", required: true, class: "flex-1 w-full rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 text-sm" %>
  <%= f.submit "Add Folder", class: "w-full sm:w-auto px-4 py-2 bg-gray-800 text-white text-sm font-medium rounded-lg hover:bg-gray-900 transition-colors cursor-pointer shrink-0" %>
<% end %>
